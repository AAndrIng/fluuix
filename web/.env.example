NEXT_PUBLIC_MODE=mock
# Set mode to chain to use the intercompany vault on Avalanche Fuji.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=
# Server only. Run db/001_intercompany.sql before enabling chain mode.
DATABASE_URL=
INTERCOMPANY_SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
AVALANCHE_RPC_URL=
# Automation on a dedicated Fuji demo vault. Apply db/002_treasury_automation.sql first.
TREASURY_AUTOMATION_VAULT=
TREASURY_AUTOMATION_PRIVATE_KEY=
# Optional for predictive evaluation in normal mode. Pitch mode simulates the threshold.
OPENAI_API_KEY=
# Optional extra funding accounts by ID and reserve in mARGt, e.g. {"2":"5"}.
TREASURY_AUTOMATION_RESERVES=
