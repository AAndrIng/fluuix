NEXT_PUBLIC_MODE=mock
# Cambiar a chain solo para integrar el vault de prueba en Avalanche Fuji.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=
# Solo servidor. Aplicar 001 y 003; agregar 002 si se usa automatización.
DATABASE_URL=
INTERCOMPANY_SESSION_SECRET=
# En producción: origen HTTPS exacto, sin ruta. HTTP solo en loopback de desarrollo.
APP_ORIGIN=http://localhost:3000
AVALANCHE_RPC_URL=
# Exclusivo para una wallet y un vault de prueba de Fuji; nunca fondos de clientes.
TREASURY_AUTOMATION_VAULT=
TREASURY_AUTOMATION_PRIVATE_KEY=
# El plazo de pitch de 5 segundos está deshabilitado hasta autorización explícita.
TREASURY_AUTOMATION_ALLOW_DEMO=false
# Opcional para predicción en modo normal. Datos de actividad siguen siendo simulados.
OPENAI_API_KEY=
# Reservas de otras cuentas, por ID y en mARGt. Ejemplo: {"2":"5"}.
TREASURY_AUTOMATION_RESERVES=
